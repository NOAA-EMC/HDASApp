members from template:
  template:
    datetime: "{{ atmosphere_background_time_iso6 }}"
    filetype: fms restart
    use_fms_lib: false
    regional restart: true
    datapath: ensemble_data/mem%mem%
    filename_core: {{atmosphere_background_time_prefix6}}fv_core.res{{nesttilestrnc}}
    filename_trcr: {{atmosphere_background_time_prefix6}}fv_tracer.res{{nesttilestrnc}}
    filename_sfcd: {{atmosphere_background_time_prefix6}}sfc_data{{nesttilestrsfc}}
    filename_sfcw: {{atmosphere_background_time_prefix6}}fv_srf_wnd.res{{nesttilestrnc}}
    filename_cplr: {{atmosphere_background_time_prefix6}}coupler.res
    state variables: {{state_variables}}
    field io names: &field_io_names
      eastward_wind: {{eastward_wind}}
      northward_wind: {{northward_wind}}
      upward_air_velocity: {{upward_air_velocity}}
      air_temperature: {{air_temperature}}
      air_pressure_thickness: {{air_pressure_thickness}}
      layer_thickness: {{layer_thickness}}
      water_vapor_mixing_ratio_wrt_moist_air: {{water_vapor_mixing_ratio_wrt_moist_air}}
      cloud_liquid_water: {{cloud_liquid_water}}
      cloud_liquid_ice: {{cloud_liquid_ice}}
      snow_water: {{snow_water}}
      rain_water: {{rain_water}}
      graupel: {{graupel}}
      cloud_ice_number_concentration: {{cloud_ice_number_concentration}}
      rain_number_concentration: {{rain_number_concentration}}
      mole_fraction_of_ozone_in_air: {{mole_fraction_of_ozone_in_air}}
      skin_temperature_at_surface: {{skin_temperature_at_surface}}
      air_pressure_at_surface: {{air_pressure_at_surface}}
      geopotential_at_surface: {{geopotential_at_surface}}
      soilMoistureVolumetric: {{soilMoistureVolumetric}}
      totalSnowDepth: {{totalSnowDepth}}
      eastward_wind_at_surface: {{eastward_wind_at_surface}}
      northward_wind_at_surface: {{northward_wind_at_surface}}
      ratio_of_wind_at_surface_adjacent_layer_to_wind_at_10m: {{ratio_of_wind_at_surface_adjacent_layer_to_wind_at_10m}}
  pattern: '%mem%'
  nmembers: {{atmosphere_number_ensemble_members}}
  zero padding: 3
